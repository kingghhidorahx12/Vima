{
  "name": "vima",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "doctor": "expo-doctor",
    "export:native": "expo export --platform android --platform ios",
    "prebuild": "expo prebuild",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:worklets": "node scripts/check-worklets.cjs",
    "check:fixture-isolation": "node scripts/check-fixture-isolation.cjs",
    "geo:gateway": "node --experimental-strip-types gateway/main.ts",
    "geo:smoke": "node --experimental-strip-types gateway/smoke.ts",
    "test:gateway": "node --experimental-strip-types --test tests/gateway.test.ts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@maplibre/maplibre-react-native": "~11.4.0",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.3.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
