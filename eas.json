{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_VIMA_VARIANT": "development"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "qa": {
      "distribution": "internal",
      "channel": "qa",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "product-preview": {
      "extends": "production",
      "distribution": "internal",
      "channel": "product-access-preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_VIMA_VARIANT": "production",
        "EXPO_PUBLIC_VIMA_AUTH_MODE": "product"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production"
    }
  }
}
