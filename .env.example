# Public MapLibre style URL from the approved TomTom Orbis Assets/Map Display setup.
# Supply an HTTPS URL through the deployment environment. DEV without it uses OpenFreeMap Positron.
# Production without it fails explicitly. Do not commit a real URL containing a key.
EXPO_PUBLIC_MAP_STYLE_URL=
# Separate public display credential for TomTom Orbis map/traffic tiles; never use the server key here.
EXPO_PUBLIC_TOMTOM_DISPLAY_KEY=

# Vima gateway URL only. HTTPS, or private LAN HTTP exclusively in DEV.
EXPO_PUBLIC_VIMA_API_BASE_URL=
# Explicit DEV fixture opt-in: 1. Empty selects live/unconfigured, never silent fixtures.
EXPO_PUBLIC_VIMA_FIXTURES=

# TomTom Places Search v3, Geocoding v2, Reverse Geocoding v2 and Routing v3
# require server-side credentials. Configure them only in the Vima backend, never EXPO_PUBLIC_*.

# Gateway only: absolute or process-relative path to approved external pricing configuration.
# Empty = route preview only. Never prefix this with EXPO_PUBLIC or commit real rates.
VIMA_PRICING_CONFIG_PATH=

# Gateway only: approved, preprocessed Vima Local WebP media and manifest outside Git.
VIMA_PLACE_MEDIA_DIR=
