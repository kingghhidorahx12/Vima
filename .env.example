# Build-only Maps SDK Android key. Inject with EAS environment or an ignored local .env.
# Restrict to Maps SDK for Android + com.kingghhidorahx12.vima + signing certificate SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=
# Optional public Google Cloud map ID. Empty = standard Google map (Vima styling pending).
EXPO_PUBLIC_GOOGLE_MAP_ID=
# Transitional MapLibre rollback/iOS only. DEV without URL uses OpenFreeMap Positron.
# Legacy release requires an HTTPS style; Android Google does not consume this URL.
EXPO_PUBLIC_MAP_STYLE_URL=
# Places/Routes credentials belong exclusively to the future backend, never this file.
